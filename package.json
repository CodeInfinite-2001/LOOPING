{
  "name": "looping",
  "version": "1.0.0",
  "description": "LOOPING - Screen Recorder & Video Splitter for Windows and Linux",
  "main": "src/main/main.js",
  "author": "LOOPING Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux tar.gz AppImage deb",
    "dist:all": "npm run dist:win && npm run dist:linux",
    "dist": "electron-builder -w"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.looping.screenrecorder",
    "productName": "LOOPING",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LOOPING"
    },
    "linux": {
      "target": [
        "tar.gz",
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Video"
    }
  }
}
